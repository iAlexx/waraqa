# Waraqa environment variables (placeholders only)
# Copy to .env.local for development. Never commit real secrets.
# See docs/SECURITY.md and docs/COMPATIBILITY_REPORT.md

# --- Server-only: database (required) ---
# Vercel / serverless runtime: Supabase Supavisor TRANSACTION pooler (port 6543).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Migrations and long-lived tooling only (never use transaction pooler here).
# Prefer Supabase DIRECT connection (port 5432) when the runner has IPv6 (or IPv4 add-on).
# If the runner is IPv4-only without the add-on, use Supavisor SESSION pooler (port 5432).
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Server-only: Payload (required) ---
# Long random string used to sign Payload tokens/cookies. Never expose to the browser.
PAYLOAD_SECRET=replace-with-long-random-string

# --- Public (required) ---
# Canonical public site origin including protocol (no trailing slash).
# Local example: http://localhost:3000
# Production example: https://your-project.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Server-only: draft preview (Phase 4 required for /preview) ---
# Long random string (≥32). Never expose to the browser or NEXT_PUBLIC_*.
PREVIEW_SECRET=replace-with-long-random-preview-secret

# --- Platform-managed (do not set manually as project secrets) ---
# NODE_ENV — set by Next.js / Node (development | production | test). Owner must not configure it.
# VERCEL_URL — set by Vercel when system env vars are enabled. Host only; does NOT include https://.
# Prefer NEXT_PUBLIC_SERVER_URL for canonical absolute URLs.
#
# Never put DATABASE_* , PAYLOAD_SECRET, or PREVIEW_SECRET in any NEXT_PUBLIC_* variable.
# Never commit real credentials.
